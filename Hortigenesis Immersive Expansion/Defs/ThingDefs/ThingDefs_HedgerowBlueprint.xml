<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<ThingDef>
		<defName>HedgerowProject_Blueprint</defName>
		<label>проект кустарника</label>
		<description>Проект для посадки буйного кустарника. Хранительница рощи займется им, когда будет свободна.</description>
		<category>Ethereal</category>
		<entityDefToBuild>Plant_Hedgerow</entityDefToBuild>
		<!-- Не имеет коллизии и физики -->
		<thingClass>HortigenesisIE.Hedgerow.HedgerowBlueprint</thingClass>
		<drawerType>MapMeshOnly</drawerType>
		<graphicData>
			<texPath>Things/Plant/Bush</texPath>
			<graphicClass>Graphic_Random</graphicClass>
			<color>(255, 255, 255, 150)</color>
			<!-- Зеленый полупрозрачный цвет -->
			<shaderType>Transparent</shaderType>
		</graphicData>
		<altitudeLayer>Blueprint</altitudeLayer>
		<passability>Standable</passability>
		<selectable>true</selectable>
		<!-- Вот это делает его выделяемым! -->
		<useHitPoints>false</useHitPoints>
		<tickerType>Never</tickerType>
		<comps>
			<!-- Ванильный компонент, дающий кнопку запрета (F) -->
			<li Class="CompProperties_Forbiddable"/>
		</comps>
	</ThingDef>

